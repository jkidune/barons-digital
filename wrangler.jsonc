{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "barons-digital",
  "compatibility_date": "2026-06-13",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "barons-digital.com",
      "custom_domain": true
    },
    {
      "pattern": "www.barons-digital.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://barons-digital.com",
    "NEXT_PUBLIC_SANITY_STUDIO_URL": "https://barons-digital-studio.kidunejoseph91.workers.dev",
    "SITE_LAUNCHED": "false"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "barons-digital"
    }
  ]
}
