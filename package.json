{
  "name": "barons-digital",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build && find .next -name '._*' -type f -delete",
    "start": "next start",
    "lint": "eslint",
    "preview": "COPYFILE_DISABLE=1 opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "COPYFILE_DISABLE=1 opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "COPYFILE_DISABLE=1 opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@opennextjs/cloudflare": "^1.19.11",
    "@sanity/image-url": "^2.1.1",
    "@studio-freight/lenis": "^1.0.42",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.3",
    "@vercel/blob": "^2.3.1",
    "clsx": "^2.1.1",
    "gsap": "^3.14.2",
    "lenis": "^1.3.19",
    "next": "^16.2.6",
    "next-sanity": "^13.0.7",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.10.0",
    "styled-components": "^6.4.2",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.100.0"
  }
}
